<Window x:Class="BadHotel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bad Hotel"
        Height="720"
        Width="900"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="170"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="BAD HOTEL"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

		<StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

			<TextBlock Text="Name:"
                       VerticalAlignment="Center"
                       Margin="5"/>

			<TextBox x:Name="NameTextBox"
                     Width="160"
                     Margin="5"/>

			<TextBlock Text="Worker type:"
                       VerticalAlignment="Center"
                       Margin="5"/>

			<ComboBox x:Name="WorkerTypeComboBox"
                      Width="150"
                      Margin="5">
				<ComboBoxItem Content="Receptionist"/>
				<ComboBoxItem Content="Cleaner"/>
				<ComboBoxItem Content="Cook"/>
			</ComboBox>

			<Button Content="Add worker"
                    Width="100"
                    Margin="5"
                    Click="AddWorkerButton_Click"/>
		</StackPanel>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="2*"/>
			</Grid.ColumnDefinitions>

			<GroupBox Header="Hotel workers"
                      Margin="5">

				<ListBox x:Name="WorkersListBox"
                         Margin="10"
                         SelectionChanged="WorkersListBox_SelectionChanged">

					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="3">
								<TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"/>
								<TextBlock Text="{Binding Energy, StringFormat=Energy: {0}/100}"
                                           FontSize="12"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
			</GroupBox>

			<GroupBox Grid.Column="1"
                      Header="Selected worker"
                      Margin="5">

				<StackPanel Margin="15">

					<TextBlock Text="Name:"
                               FontWeight="Bold"/>

					<TextBlock x:Name="SelectedNameText"
                               Text="No worker selected"
                               FontSize="18"
                               Margin="0,3,0,10"/>

					<TextBlock Text="Type:"
                               FontWeight="Bold"/>

					<TextBlock x:Name="SelectedTypeText"
                               Text="-"
                               FontSize="16"
                               Margin="0,3,0,10"/>

					<TextBlock Text="Energy:"
                               FontWeight="Bold"/>

					<TextBlock x:Name="SelectedEnergyText"
                               Text="-"
                               Margin="0,3,0,5"/>

					<ProgressBar x:Name="EnergyProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="25"
                                 Value="0"
                                 Margin="0,0,0,15"/>

					<Button Content="Work"
                            Height="35"
                            Margin="0,5"
                            Click="WorkButton_Click"/>

					<Button Content="Special ability"
                            Height="35"
                            Margin="0,5"
                            Click="SpecialAbilityButton_Click"/>

					<Button Content="CRAZY ACTION!"
                            Height="35"
                            Margin="0,5"
                            Click="CrazyActionButton_Click"/>

					<Button Content="Remove worker"
                            Height="35"
                            Margin="0,5"
                            Click="RemoveWorkerButton_Click"/>

				</StackPanel>
			</GroupBox>
		</Grid>

		<GroupBox Grid.Row="3"
                  Header="Activity log"
                  Margin="5">

			<ListBox x:Name="ActivityLogListBox"
                     Margin="10"/>
		</GroupBox>

	</Grid>
</Window>